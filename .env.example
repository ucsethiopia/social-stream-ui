# Keep true until the dev API is cleared for testing — real requests publish to the website.
NEXT_PUBLIC_API_MOCK=true
# `next build` refuses mock mode unless this is set (deliberate demo deploys only).
# ALLOW_MOCK_BUILD=true
# With mock off: talk to a *local* API for real, but keep uploads in the browser and block
# channel connects, team changes and social publishing. Refuses any non-localhost API.
NEXT_PUBLIC_LOCAL_SAFE_MODE=true
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SOCIAL_STREAM_API_URL=http://localhost:8002
NEXT_PUBLIC_API_HASHTAGS_FIELD=false
NEXT_PUBLIC_COMPANY_SITE_URL=https://dev.ucsethiopia.com
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=ucsethiopia.com
